APP_NAME=powerbook-api
ENVIRONMENT=local
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/powerbook
DB_ECHO=false

# Telegram bot: who it tells about nickname requests waiting in /admin
# (numeric chat ids, comma-separated; each must have pressed Start in the bot)
TELEGRAM_ADMIN_CHAT_IDS=
